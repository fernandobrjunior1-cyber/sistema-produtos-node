<h1>Editar Produto</h1>

<form
 <form action="/products/update/save/{{product._id}}
 " method="POST" enctype="multipart/form-data"> 
>

    <div>
        <label>Nome:</label>
        <input
            type="text"
            name="name"
            value="{{product.name}}"
            required
        >
    </div>

    <br>

    <div>
        <label>Preço:</label>
        <input
            type="number"
            step="0.01"
            name="price"
            value="{{product.price}}"
            required
        >
    </div>

    <br>

    <div>
        <label>Imagem do Produto:</label>
        
        {{#if product.image}}
            <div style="margin-bottom: 10px;">
                <p style="font-size: 14px; color: #aaa;">Imagem atual:</p>
                <img src="/uploads/{{product.image}}" alt="Preview" style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #00ffff; border-radius: 8px;">
            </div>
        {{/if}}

        <input
            type="file"
            name="image"
            accept="image/*"
        >
    </div>

    <br>

    <button type="submit">
        Atualizar
    </button>

</form>