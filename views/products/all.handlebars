<h1>Lista de Produtos</h1>

{{#if products.length}}
<div class="products-container">
    {{#each products}}
    <div class="product-card">
        
        <h2>{{this.name}}</h2>

        {{#if this.image}}
            <img src="/uploads/{{this.image}}" alt="{{this.name}}">
        {{/if}}

        <p>Preço: R$ {{this.price}}</p>

        <div class="card-actions">
            <a href="/products/update/{{this._id}}">Editar</a>
            
            <form action="/products/delete/{{this._id}}?_method=DELETE" method="POST" style="display: inline; background: none; border: none; padding: 0; box-shadow: none;">
                <button type="submit">Excluir</button>
            </form>
        </div>

    </div>
    {{/each}}
</div>
{{else}}
<p>Nenhum produto cadastrado.</p>
{{/if}}

<form action="/products" method="GET" class="search-form">
    <input type="text" name="search" placeholder="Pesquisar produto..." value="{{search}}">
    <button type="submit">Buscar</button>
</form>