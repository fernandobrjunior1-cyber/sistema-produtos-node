{{#if message}}
<div class="success-message">
    {{message}}
</div>
{{/if}}

<h1>Login</h1>

<form action="/login" method="POST">

    <label>Email</label>
    <input type="email" name="email">

    <label>Senha</label>
    <input type="password" name="password">

    <button type="submit">
        Entrar
    </button>

</form>